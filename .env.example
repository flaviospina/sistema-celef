# =====================================================================================================
# .env.example — Sistema de Gestão Escolar CELEF
# Copie para .env (fora de public/), preencha e ajuste a permissão do arquivo para 600 no Gerenciador de Arquivos.
# NUNCA coloque este arquivo em public/. Linhas que começam com # são comentários.
# =====================================================================================================

# ---- Aplicação ---------------------------------------------------------------------------------------
APP_ENV=production                  # production | development (development mostra erros detalhados na tela)
APP_DEBUG_ERRORS=0                  # 1 = mostra a causa do erro na tela mesmo em produção (só durante a instalação!)
APP_NAME="Sistema CELEF"
BASE_URL=https://celef.exemplo.com.br   # URL pública, sem barra no final
APP_TIMEZONE=America/Sao_Paulo

# ---- Banco de dados (usuário DA APLICAÇÃO: só SELECT, INSERT, UPDATE, EXECUTE) ---------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=prefixo_celef
DB_USER=prefixo_celef_app
DB_PASS=

# ---- Chaves de criptografia (geradas na página /instalacao do sistema, uma única vez) ---------------
# APP_KEY_V1: chave XChaCha20-Poly1305 (32 bytes, base64). Para rotacionar, adicione APP_KEY_V2 e mude APP_KEY_VERSION=2.
APP_KEY_VERSION=1
APP_KEY_V1=
# Chave separada do blind index (HMAC-SHA256) — NUNCA rotacionar sem recalcular todos os índices.
BLIND_INDEX_KEY=

# ---- Super Administradores protegidos (não podem ser rebaixados/desativados pela interface) ---------
SUPER_ADMIN_EMAILS=flaviospina@scseduca.com.br

# ---- Login Google (Fase 3): app OAuth "Interno" do Workspace scseduca.com.br -----------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_HOSTED_DOMAIN=scseduca.com.br

# ---- Conta técnica Google (Fase 4) ---------------------------------------------------------------------
# Deixe COMENTADO para usar o mesmo app OAuth do login (recomendado). Só preencha se criar um segundo cliente.
#GOOGLE_TECH_CLIENT_ID=
#GOOGLE_TECH_CLIENT_SECRET=

# ---- E-mail de alertas (Fase 10) --------------------------------------------------------------------
MAIL_FROM=sistema@celef.exemplo.com.br
MAIL_FROM_NAME="Sistema CELEF"

# ---- Diagnóstico ---------------------------------------------------------------------------------------
# Token para a página /status?token=... mostrar detalhes (PHP, extensões, banco). Vazio = só "OK/erro".
STATUS_TOKEN=
LOG_RETENTION_DAYS=180
